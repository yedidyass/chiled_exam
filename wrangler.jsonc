{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiled-exam",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chiled-exam-db",
      // מוחלף אוטומטית ב-workflow של ה-deploy (נוצר אם לא קיים)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // שעות UTC. 16:00 UTC = 18:00/19:00 בישראל (חורף/קיץ), א׳–ה׳ — בלי שישי ושבת.
  // 05:30 UTC ביום ראשון = 07:30/08:30 — סיכום שבועי.
  "triggers": { "crons": ["0 16 * * SUN-THU", "30 5 * * SUN"] },
  // משתנים שמוגדרים בדשבורד (למשל ALLOW_SIGNUP) לא יימחקו ב-deploy
  "keep_vars": true,
  "observability": { "enabled": true }
}
